
<%-include('header.ejs');%>

<div class="admin-main">

    <main class="dashboard-content">

        <div class="container-fluid px-3 px-lg-4 py-4">

            <div class="page-heading">

                <div class="page-heading-copy">

                    <span class="page-icon">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                    </span>

                    <div>

                        <p class="eyebrow mb-1">
                            About
                        </p>
                     <h1 class="h3 mb-1">
                            About List
                        </h1>

                        <p class="text-muted mb-0">
                            Manage About information.
                        </p>

                    </div>

                </div>

            </div>


            <section class="row g-3">

                <div class="col-12">

                    <div class="panel">

                        <div class="panel-header">

                            <div>

                                <h2 class="h5 mb-1 section-title">

                                    <i class="bi bi-info-circle" aria-hidden="true"></i>

                                    <span>
                                        About Details
                                    </span>

                                </h2>

                                <p class="text-muted mb-0">
                                    View and manage About information.
                                </p>

                            </div>

                            <div>

                                <a href="/admin/about_add"
                                   class="btn btn-primary">

                                    <i class="bi bi-plus-lg"></i>

                                    Add About

                                </a>

                            </div>

                        </div>


                        <div class="table-responsive">

                            <table class="table align-middle">

                                <thead>

                                    <tr>

                                        <th>ID</th>

                                        <th>Title</th>

                                        <th>Description</th>

                                        <th>About Image</th>

                                        <th>CEO Name</th>

                                        <th>CEO Position</th>

                                        <th>CEO Image</th>

                                        <th>Vision Title</th>

                                        <th>Vision Description</th>

                                        <th>Vision Image</th>

                                        <th>Mission Title</th>

                                        <th>Mission Description</th>

                                        <th>Mission Image</th>

                                        <th class="text-end">
                                            Action
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    <% data.forEach(function(item){ %>

                                    <tr>

                                        <td class="fw-semibold">
                                          <%= item+1%>
                                        </td>


                                        <td>
                                            <%= item.title %>
                                        </td>


                                        <td>
                                            <%= item.a_desc %>
                                        </td>


                                        <td>

                                            <% if(item.a_img){ %>

                                                <img
                                                    src="/img/<%= item.a_img %>"
                                                    width="80"
                                                    height="60"
                                                    style="object-fit:cover;">

                                            <% } %>

                                        </td>


                                        <td>
                                            <%= item.ceo_name %>
                                        </td>


                                        <td>
                                            <%= item.c_position %>
                                        </td>


                                        <td>

                                            <% if(item.ceo_img){ %>

                                                <img
                                                    src="/img/<%= item.ceo_img %>"
                                                    width="80"
                                                    height="60"
                                                    style="object-fit:cover;">

                                            <% } %>

                                        </td>


                                        <td>
                                            <%= item.vision_title %>
                                        </td>


                                        <td>
                                            <%= item.vision_desc %>
                                        </td>


                                        <td>

                                            <% if(item.vision_img){ %>

                                                <img
                                                    src="/img/<%= item.vision_img %>"
                                                    width="80"
                                                    height="60"
                                                    style="object-fit:cover;">

                                            <% } %>

                                        </td>


                                        <td>
                                            <%= item.mission_title %>
                                        </td>


                                        <td>
                                            <%= item.mission_desc %>
                                        </td>


                                        <td>

                                            <% if(item.mission_img){ %>

                                                <img
                                                    src="/img/<%= item.mission_img %>"
                                                    width="80"
                                                    height="60"
                                                    style="object-fit:cover;">

                                            <% } %>

                                        </td>


                                        <td class="text-end">

                                            <a
                                                href="/admin/about_edit/<%= item.aid %>"
                                                class="btn btn-light btn-sm">

                                                <i class="bi bi-pencil"></i>

                                                Edit

                                            </a>


                                            <a
                                                href="/admin/about_delete/<%= item.aid %>"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this About?')">

                                                <i class="bi bi-trash"></i>

                                                Delete

                                            </a>

                                        </td>

                                    </tr>

                                    <% }) %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </section>

        </div>

    </main>

</div>

<%-include('footer.ejs');%>
