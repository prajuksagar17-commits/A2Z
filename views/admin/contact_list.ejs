<%-include('header.ejs');%>

<div class="admin-main">
    <main class="dashboard-content">
        <div class="container-fluid px-3 px-lg-4 py-4">

            <div class="page-heading">
                <div class="page-heading-copy">
                    <span class="page-icon">
                        <i class="bi bi-envelope"></i>
                    </span>
                    <div>
                        <p class="eyebrow mb-1">Contact</p>
                        <h1 class="h3 mb-1">Contact List</h1>
                        <p class="text-muted mb-0">Manage Contact Information.</p>
                    </div>
                </div>
            </div>

            <section class="row g-3">
                <div class="col-12">
                    <div class="panel">

                        <div class="panel-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">All Contacts</h5>

                            <a href="/admin/contact_add" class="btn btn-primary btn-sm">
                                <i class="bi bi-plus-lg"></i> Add Contact
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table align-middle">

                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Title</th>
                                        <th>Description</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Mobile</th>
                                        <th>Subject</th>
                                        <th>Message</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% contact.forEach(function(data, i) { %>

                                    <tr>
                                        <td class="fw-semibold"><%= i+1 %></td>
                                        <td><%= data.title %></td>
                                        <td><%= data.desc %></td>
                                        <td><%= data.name %></td>
                                        <td><%= data.email %></td>
                                        <td><%= data.mobile %></td>
                                        <td><%= data.sub %></td>
                                        <td><%= data.mess %></td>

                                        <td class="text-end">
                                            <a href="/admin/contact_delete/<%= data.cid %>"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this contact?')">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </td>
                                    </tr>

                                    <% }); %>
                                </tbody>

                            </table>
                        </div>

                    </div>
                </div>
            </section>

        </div>
    </main>
</div>

<%-include('footer.ejs');%>