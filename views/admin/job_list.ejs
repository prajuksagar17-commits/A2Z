<%-include('header.ejs');%>

<div class="admin-main">

    <main class="dashboard-content">

        <div class="container-fluid px-3 px-lg-4 py-4">

            <div class="page-heading">

                <div class="page-heading-copy">

                    <span class="page-icon">
                        <i class="bi bi-briefcase" aria-hidden="true"></i>
                    </span>

                    <div>

                        <p class="eyebrow mb-1">
                            Jobs
                        </p>

                        <h1 class="h3 mb-1">
                            Job List
                        </h1>

                        <p class="text-muted mb-0">
                            Manage Job information.
                        </p>

                    </div>

                </div>

            </div>


            <section class="row g-3">

                <div class="col-12">

                    <div class="panel">

                        <div class="panel-header">

                            <div>

                                <h2 class="h5 mb-1 section-title">

                                    <i class="bi bi-briefcase" aria-hidden="true"></i>

                                    <span>
                                        Job Details
                                    </span>

                                </h2>

                                <p class="text-muted mb-0">
                                    View and manage all jobs.
                                </p>

                            </div>

                        </div>


                        <div class="table-responsive">

                            <table class="table align-middle">

                                <thead>

                                    <tr>

                                        <th>ID</th>
                                        <th>Title 1</th>
                                        <th>Description 1</th>
                                        <th>Position</th>
                                        <th>City</th>
                                        <th>Search</th>
                                        <th>Job</th>
                                        <th>Experience</th>
                                        <th>Salary</th>
                                        <th>Location</th>
                                        <th>Role Description</th>
                                        <th>Title 2</th>
                                        <th>Description 2</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Mobile</th>
                                        <th>Preferred Position</th>
                                        <th>Preferred Area</th>

                                        <th class="text-end">
                                            Action
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    <% jobs.forEach(function(data, i) { %>

                                    <tr>

                                        <td class="fw-semibold">
                                            <%= i+1 %>
                                        </td>

                                        <td>
                                            <%= data.title_1 %>
                                        </td>

                                        <td>
                                            <%= data.desc1 %>
                                        </td>

                                        <td>
                                            <%= data.position %>
                                        </td>

                                        <td>
                                            <%= data.city %>
                                        </td>

                                        <td>
                                            <%= data.search %>
                                        </td>

                                        <td>
                                            <%= data.job %>
                                        </td>

                                        <td>
                                            <%= data.j_experience %>
                                        </td>

                                        <td>
                                            <%= data.sallery %>
                                        </td>

                                        <td>
                                            <%= data.location %>
                                        </td>

                                        <td>
                                            <%= data.role_Description %>
                                        </td>

                                        <td>
                                            <%= data.title_2 %>
                                        </td>

                                        <td>
                                            <%= data.desc2 %>
                                        </td>

                                        <td>
                                            <%= data.name %>
                                        </td>

                                        <td>
                                            <%= data.email %>
                                        </td>

                                        <td>
                                            <%= data.mobile %>
                                        </td>

                                        <td>
                                            <%= data.preffered_position %>
                                        </td>

                                        <td>
                                            <%= data.preffered_area %>
                                        </td>

                                        <td class="text-end">

                                            <a
                                                href="/admin/job_delete/<%= data.jid %>"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this job?')">

                                                Delete

                                            </a>

                                        </td>

                                    </tr>

                                    <% }); %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </section>

        </div>

    </main>

</div>

<%-include('footer.ejs');%>