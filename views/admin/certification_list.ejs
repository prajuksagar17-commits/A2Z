<%-include('header.ejs');%>

<div class="admin-main">

    <main class="dashboard-content">

        <div class="container-fluid px-3 px-lg-4 py-4">

            <div class="page-heading">

                <div class="page-heading-copy">

                    <span class="page-icon">
                        <i class="bi bi-award" aria-hidden="true"></i>
                    </span>

                    <div>

                        <p class="eyebrow mb-1">
                            Certification
                        </p>

                        <h1 class="h3 mb-1">
                            Certification List
                        </h1>

                        <p class="text-muted mb-0">
                            Manage Certification information.
                        </p>

                    </div>

                </div>

            </div>


            <section class="row g-3">

                <div class="col-12">

                    <div class="panel">

                        <div class="panel-header">

                            <div>

                                <h2 class="h5 mb-1 section-title">

                                    <i class="bi bi-award" aria-hidden="true"></i>

                                    <span>
                                        Certification Details
                                    </span>

                                </h2>

                                <p class="text-muted mb-0">
                                    View and manage all certifications.
                                </p>

                            </div>

                        </div>


                        <div class="table-responsive">

                            <table class="table align-middle">

                                <thead>

                                    <tr>

                                        <th>ID</th>

                                        <th>Title 1</th>

                                        <th>Description 1</th>

                                        <th>Title 2</th>

                                        <th>Name</th>

                                        <th>Certification No</th>

                                        <th>Mobile</th>

                                        <th>Icon</th>

                                        <th>Title 3</th>

                                        <th>Description 2</th>

                                        <th>Instruction</th>

                                        <th class="text-end">
                                            Action
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    <% certification.forEach(function(data, i) { %>

                                    <tr>

                                        <td class="fw-semibold">
                                            <%= i+1 %>
                                        </td>

                                        <td>
                                            <%= data.title1 %>
                                        </td>

                                        <td>
                                            <%= data.desc1 %>
                                        </td>

                                        <td>
                                            <%= data.title_2 %>
                                        </td>

                                        <td>
                                            <%= data.name %>
                                        </td>

                                        <td>
                                            <%= data.certification_no %>
                                        </td>

                                        <td>
                                            <%= data.mobile %>
                                        </td>

                                        <td>
                                            <%= data.icon %>
                                        </td>

                                        <td>
                                            <%= data.title_3 %>
                                        </td>

                                        <td>
                                            <%= data.desc2 %>
                                        </td>

                                        <td>
                                            <%= data.instruction %>
                                        </td>

                                        <td class="text-end">

                                            <a
                                                href="/admin/certification_delete/<%= data.cid %>"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this certification?')">

                                                Delete

                                            </a>

                                        </td>

                                    </tr>

                                    <% }); %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </section>

        </div>

    </main>

</div>

<%-include('footer.ejs');%>