<%-include('header.ejs');%>

<div class="admin-main">

    <main class="dashboard-content">

        <div class="container-fluid px-3 px-lg-4 py-4">

            <div class="page-heading">

                <div class="page-heading-copy">

                    <span class="page-icon">
                        <i class="bi bi-briefcase" aria-hidden="true"></i>
                    </span>

                    <div>

                        <p class="eyebrow mb-1">
                            Placements
                        </p>

                        <h1 class="h3 mb-1">
                            Placement List
                        </h1>

                        <p class="text-muted mb-0">
                            Manage Placement information.
                        </p>

                    </div>

                </div>

            </div>


            <section class="row g-3">

                <div class="col-12">

                    <div class="panel">

                        <div class="panel-header">

                            <div>

                                <h2 class="h5 mb-1 section-title">

                                    <i class="bi bi-briefcase" aria-hidden="true"></i>

                                    <span>
                                        Placement Details
                                    </span>

                                </h2>

                                <p class="text-muted mb-0">
                                    View and manage all placements.
                                </p>

                            </div>

                        </div>


                        <div class="table-responsive">

                            <table class="table align-middle">

                                <thead>

                                    <tr>

                                        <th>ID</th>

                                        <th>Title 1</th>

                                        <th>Title 2</th>

                                        <th>Description 1</th>

                                        <th>Title 3</th>

                                        <th>Description 2</th>

                                        <th>Image</th>

                                        <th>Course Name</th>

                                        <th>Title 4</th>

                                        <th>Description 3</th>

                                        <th>Image 2</th>

                                        <th>Student Name</th>

                                        <th>Description 4</th>

                                        <th>Icon 1</th>

                                        <th>Company</th>

                                        <th>Title 5</th>

                                        <th>Icon 2</th>

                                        <th>Student Name 2</th>

                                        <th>Course</th>

                                        <th class="text-end">
                                            Action
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    <% placement.forEach(function(data, i) { %>

                                    <tr>

                                        <td class="fw-semibold">
                                            <%= i+1 %>
                                        </td>

                                        <td>
                                            <%= data.title1 %>
                                        </td>

                                        <td>
                                            <%= data.title_2 %>
                                        </td>

                                        <td>
                                            <%= data.desc1 %>
                                        </td>

                                        <td>
                                            <%= data.title_3 %>
                                        </td>

                                        <td>
                                            <%= data.desc2 %>
                                        </td>

                                        <td>

                                            <% if (data.img) { %>

                                                <img
                                                    src="/admin/img/<%= data.img %>"
                                                    width="80"
                                                    height="60"
                                                    style="object-fit: cover;">

                                            <% } %>

                                        </td>

                                        <td>
                                            <%= data.course_name %>
                                        </td>

                                        <td>
                                            <%= data.title_4 %>
                                        </td>

                                        <td>
                                            <%= data.desc3 %>
                                        </td>

                                        <td>

                                            <% if (data.img2) { %>

                                                <img
                                                    src="/admin/img/<%= data.img2 %>"
                                                    width="80"
                                                    height="60"
                                                    style="object-fit: cover;">

                                            <% } %>

                                        </td>

                                        <td>
                                            <%= data.student_name %>
                                        </td>

                                        <td>
                                            <%= data.desc4 %>
                                        </td>

                                        <td>
                                            <%= data.icon1 %>
                                        </td>

                                        <td>
                                            <%= data.company %>
                                        </td>

                                        <td>
                                            <%= data.title_5 %>
                                        </td>

                                        <td>
                                            <%= data.icon_2 %>
                                        </td>

                                        <td>
                                            <%= data.student_name_2 %>
                                        </td>

                                        <td>
                                            <%= data.course %>
                                        </td>

                                        <td class="text-end">

                                            <a
                                                href="/admin/placement_delete/<%= data.pid %>"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this placement?')">

                                                Delete

                                            </a>

                                        </td>

                                    </tr>

                                    <% }); %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </section>

        </div>

    </main>

</div>

<%-include('footer.ejs');%>