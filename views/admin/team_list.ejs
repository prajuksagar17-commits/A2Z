<%-include('header.ejs');%>

<div class="admin-main">
    <main class="dashboard-content">
        <div class="container-fluid px-3 px-lg-4 py-4">

            <div class="page-heading">
                <div class="page-heading-copy">
                    <span class="page-icon">
                        <i class="bi bi-people" aria-hidden="true"></i>
                    </span>
                    <div>
                        <p class="eyebrow mb-1">Team</p>
                        <h1 class="h3 mb-1">Team List</h1>
                        <p class="text-muted mb-0">Manage Team Members.</p>
                    </div>
                </div>
            </div>

            <section class="row g-3">
                <div class="col-12">

                    <div class="panel">

                        <div class="panel-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">All Team Members</h5>

                            <a href="/admin/team_add" class="btn btn-primary btn-sm">
                                <i class="bi bi-plus-lg"></i> Add Team
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table align-middle">

                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Title</th>
                                        <th>Description</th>
                                        <th>Image</th>
                                        <th>Name</th>
                                        <th>Position</th>
                                        <th>Description 2</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% team.forEach(function(data, i) { %>

                                    <tr>
                                        <td class="fw-semibold"><%= i+1 %></td>

                                        <td><%= data.title %></td>

                                        <td><%= data.desc %></td>

                                        <td>
                                            <img src="/admin/img/<%= data.image %>"
                                                alt="Team Member"
                                                style="width:70px;height:70px;object-fit:cover;border-radius:8px;">
                                        </td>

                                        <td><%= data.name %></td>

                                        <td><%= data.position %></td>

                                        <td><%= data.desc2 %></td>

                                        <td class="text-end">
                                            <a href="/admin/team_delete/<%= data.tid %>"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this team member?')">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </td>
                                    </tr>

                                    <% }); %>
                                </tbody>

                            </table>
                        </div>

                    </div>

                </div>
            </section>

        </div>
    </main>
</div>

<%-include('footer.ejs');%>