<%-include('header.ejs');%>

<div class="admin-main">

    <main class="dashboard-content">

        <div class="container-fluid px-3 px-lg-4 py-4">

            <div class="page-heading">

                <div class="page-heading-copy">

                    <span class="page-icon">
                        <i class="bi bi-briefcase" aria-hidden="true"></i>
                    </span>

                    <div>

                        <p class="eyebrow mb-1">
                            Placements
                        </p>

                        <h1 class="h3 mb-1">
                            Add Placement
                        </h1>

                        <p class="text-muted mb-0">
                            Add Placement information.
                        </p>

                    </div>

                </div>

            </div>


            <section class="row g-3">

                <div class="col-12 col-xl-8">

                    <form class="panel"
                          action="/admin/placement_save"
                          method="POST"
                          enctype="multipart/form-data">

                        <div class="panel-header">

                            <div>

                                <h2 class="h5 mb-1 section-title">

                                    <i class="bi bi-briefcase" aria-hidden="true"></i>

                                    <span>
                                        Placement Details
                                    </span>

                                </h2>

                                <p class="text-muted mb-0">
                                    Add complete Placement information.
                                </p>

                            </div>

                        </div>


                        <!-- Title 1 -->

                        <div class="mb-3">

                            <label class="form-label" for="title1">
                                Title 1
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="title1"
                                name="title1"
                                required>

                        </div>


                        <!-- Title 2 -->

                        <div class="mb-3">

                            <label class="form-label" for="title_2">
                                Title 2
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="title_2"
                                name="title_2"
                                required>

                        </div>


                        <!-- Description 1 -->

                        <div class="mb-3">

                            <label class="form-label" for="desc1">
                                Description 1
                            </label>

                            <textarea
                                class="form-control"
                                id="desc1"
                                name="desc1"
                                rows="5"
                                required></textarea>

                        </div>


                        <!-- Title 3 -->

                        <div class="mb-3">

                            <label class="form-label" for="title_3">
                                Title 3
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="title_3"
                                name="title_3"
                                required>

                        </div>


                        <!-- Description 2 -->

                        <div class="mb-3">

                            <label class="form-label" for="desc2">
                                Description 2
                            </label>

                            <textarea
                                class="form-control"
                                id="desc2"
                                name="desc2"
                                rows="5"
                                required></textarea>

                        </div>


                        <!-- Image 1 -->

                        <div class="mb-3">

                            <label class="form-label" for="img">
                                Placement Image
                            </label>

                            <input
                                type="file"
                                class="form-control"
                                id="img"
                                name="img"
                                accept="image/*"
                                required>

                        </div>


                        <!-- Course Name -->

                        <div class="mb-3">

                            <label class="form-label" for="course_name">
                                Course Name
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="course_name"
                                name="course_name"
                                required>

                        </div>


                        <!-- Title 4 -->

                        <div class="mb-3">

                            <label class="form-label" for="title_4">
                                Title 4
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="title_4"
                                name="title_4"
                                required>

                        </div>


                        <!-- Description 3 -->

                        <div class="mb-3">

                            <label class="form-label" for="desc3">
                                Description 3
                            </label>

                            <textarea
                                class="form-control"
                                id="desc3"
                                name="desc3"
                                rows="5"
                                required></textarea>

                        </div>


                        <!-- Image 2 -->

                        <div class="mb-3">

                            <label class="form-label" for="img2">
                                Student Image
                            </label>

                            <input
                                type="file"
                                class="form-control"
                                id="img2"
                                name="img2"
                                accept="image/*"
                                required>

                        </div>


                        <!-- Student Name -->

                        <div class="mb-3">

                            <label class="form-label" for="student_name">
                                Student Name
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="student_name"
                                name="student_name"
                                required>

                        </div>


                        <!-- Description 4 -->

                        <div class="mb-3">

                            <label class="form-label" for="desc4">
                                Description 4
                            </label>

                            <textarea
                                class="form-control"
                                id="desc4"
                                name="desc4"
                                rows="5"
                                required></textarea>

                        </div>


                        <!-- Icon 1 -->

                        <div class="mb-3">

                            <label class="form-label" for="icon1">
                                Icon 1
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="icon1"
                                name="icon1"
                                required>

                        </div>


                        <!-- Company -->

                        <div class="mb-3">

                            <label class="form-label" for="company">
                                Company
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="company"
                                name="company"
                                required>

                        </div>


                        <!-- Title 5 -->

                        <div class="mb-3">

                            <label class="form-label" for="title_5">
                                Title 5
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="title_5"
                                name="title_5"
                                required>

                        </div>


                        <!-- Icon 2 -->

                        <div class="mb-3">

                            <label class="form-label" for="icon_2">
                                Icon 2
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="icon_2"
                                name="icon_2"
                                required>

                        </div>


                        <!-- Student Name 2 -->

                        <div class="mb-3">

                            <label class="form-label" for="student_name_2">
                                Student Name 2
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="student_name_2"
                                name="student_name_2"
                                required>

                        </div>


                        <!-- Course -->

                        <div class="mb-3">

                            <label class="form-label" for="course">
                                Course
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="course"
                                name="course"
                                required>

                        </div>


                        <!-- Submit -->

                        <div class="d-flex justify-content-end mt-4">

                            <button
                                class="btn btn-primary"
                                type="submit">

                                <i class="bi bi-save" aria-hidden="true"></i>

                                Save Placement

                            </button>

                        </div>

                    </form>

                </div>

            </section>

        </div>

    </main>

</div>

<%-include('footer.ejs');%>