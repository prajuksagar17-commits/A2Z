<%-include('header.ejs');%>

<!-- ================= JOB TITLE BANNER ================= -->

<section class="page-banner">

    <h1>JOBS</h1>

</section>


<!-- ================= CAREER OPPORTUNITIES ================= -->

<section class="jobs-section">

    <div class="container">

        <div class="section-title">

            <h2><%= jdata.title_1 %></h2>

            <p>
                 <%= jdata.desc1 %>
            </p>

        </div>


        <!-- ================= FILTER BOX ================= -->

        <div class="filter-box">

            <div class="filter-item">

                <label>POSITION</label>

                <select id="positionFilter">

                    <option value="">All Positions</option>

                    <option value="Angular Developer">
                         <%= jdata.position %>
                    </option>

                    <option value="Node.js Developer">
                        Node.js Developer
                    </option>

                    <option value="Java Developer">
                        Java Developer
                    </option>

                </select>

            </div>


            <div class="filter-item">

                <label>AREA / CITY</label>

                <select id="areaFilter">

                    <option value="">All Areas</option>

                    <option value="Ahmednagar">
                        <%= jdata.city %>
                    </option>

                    <option value="Pune">
                        Pune
                    </option>

                    <option value="Mumbai">
                        Mumbai
                    </option>

                </select>

            </div>


            <div class="filter-item">

                <label>SEARCH</label>

                <input
                    type="text"
                    id="searchInput"
                    placeholder=" <%= jdata.search %>..."
                >

            </div>


            <button class="filter-btn" onclick="filterJobs()">
                <i class="fa-solid fa-filter"></i>
                Filter
            </button>


            <button class="reset-btn" onclick="resetJobs()">
                Reset
            </button>

        </div>


        <!-- JOB COUNT -->

        <div class="job-count">

            <span id="jobCount">3</span> jobs found

        </div>


        <!-- ================= JOB CARDS ================= -->

        <div class="jobs-grid" id="jobsContainer">


            <!-- JOB 1 -->

            <div class="job-card"
                 jdata-position="Angular Developer"
                 jdata-area="Ahmednagar">

                <div class="job-top-line"></div>

                <h3> <%= jdata.job %></h3>

                <div class="job-info">

                    <span>
                        <i class="fa-regular fa-clock"></i>
                       <%= jdata.j_experience %>
                    </span>

                    <span class="salary">
                        <i class="fa-solid fa-indian-rupee-sign"></i>
                      <%= jdata.sallery %>
                    </span>

                </div>

                <div class="location">

                    <i class="fa-solid fa-location-dot"></i>

                    <%= jdata.location %>

                </div>


                <h4>ROLE DETAILS</h4>

                <div class="role-details">

                    <p>
                         <%= jdata.role_Description %>
                    </p>
                

                </div>

                <a href="#" class="read-more">
                    Read more
                </a>

                <button class="apply-btn"
                        onclick="openApply('Angular Developer')">

                    Enquire / Apply

                </button>

            </div>


