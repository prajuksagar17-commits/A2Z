        <!-- ================= JOB UPDATE FORM ================= -->

        <div class="job-update-box">

            <div class="update-content">

                <h2><%= jdata.title_2 %></h2>

                <p>
                   <%= jdata.desc2 %>
                </p>

            </div>


            <form class="update-form"
                  onsubmit="notifyJob(event)">

                <input
                    type="text"
                    placeholder="<%= jdata.name %>"
                    required
                >

                <input
                    type="email"
                    placeholder=" <%= jdata.email %>"
                    required
                >

                <input
                    type="tel"
                    placeholder="<%= jdata.mobile %>"
                    maxlength="10"
                    required
                >

                <input
                    type="text"
                    placeholder=" <%= jdata.preffered_position %>"
                >

                <input
                    type="text"
                    placeholder="<%= jdata.preffered_area %>"
                >

                <button type="submit">

                    <i class="fa-solid fa-bell"></i>

                    Notify Me

                </button>

            </form>

        </div>


    </div>

</section>


<!-- ================= PLACEMENT GUIDANCE ================= -->

<section class="placement-guidance">

    <div class="guidance-content">

        <h2>Need placement guidance?</h2>

        <p>
            Talk to our counsellors for job-oriented courses
            and interview prep.
        </p>

        <button onclick="openEnquiry()">

            <i class="fa-solid fa-envelope"></i>

            Enquire Now

        </button>

    </div>

</section>


<!-- ================= FLOATING ENQUIRY ================= -->

<button class="floating-enquiry"
        onclick="openEnquiry()">

    <i class="fa-solid fa-envelope"></i>

    Enquiry

</button>


<!-- ================= ENQUIRY MODAL ================= -->

<div class="modal" id="enquiryModal">

    <div class="modal-box">

        <button class="close-modal"
                onclick="closeEnquiry()">

            ×

        </button>

        <h2>Enquire Now</h2>

        <p>
            Fill in your details and our team will contact you.
        </p>

        <form onsubmit="submitEnquiry(event)">

            <input
                type="text"
                placeholder="First Name"
                required
            >

            <input
                type="text"
                placeholder="Last Name"
                required
            >

            <input
                type="email"
                placeholder="Email"
                required
            >

            <input
                type="tel"
                placeholder="Mobile Number"
                maxlength="10"
                required
            >

            <button type="submit">
                Submit Enquiry
            </button>

        </form>

    </div>

</div>


<%-include('footer.ejs');%>