<!-- ================= FLOATING ENQUIRY ================= -->

<button class="floating-enquiry"
        onclick="openEnquiry()">

    <i class="fa-solid fa-paper-plane"></i>

    <span>Enquiry</span>

</button>


<!-- ================= ENQUIRY MODAL ================= -->

<div class="modal" id="enquiryModal">

    <div class="modal-overlay"
         onclick="closeEnquiry()"></div>

    <div class="modal-box">

        <button class="close-modal"
                onclick="closeEnquiry()">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="modal-header">

            <span>
                QUICK REGISTRATION
            </span>

            <h2>
                Register For Course!
            </h2>

            <p>
                Get Free Demo & Course Details
            </p>

        </div>


        <form id="enquiryForm">

            <div class="form-row">

                <div class="form-group">

                    <label>First Name</label>

                    <input type="text"
                           id="firstName"
                           placeholder="Enter First Name"
                           required>

                </div>


                <div class="form-group">

                    <label>Last Name</label>

                    <input type="text"
                           id="lastName"
                           placeholder="Enter Last Name"
                           required>

                </div>

            </div>


            <div class="form-group">

                <label>Email</label>

                <input type="email"
                       id="email"
                       placeholder="Enter Email"
                       required>

            </div>


            <div class="form-group">

                <label>Mobile Number</label>

                <input type="tel"
                       id="mobile"
                       placeholder="Enter Mobile No."
                       maxlength="10"
                       required>

            </div>


            <div class="form-group">

                <label>Select Course</label>

                <select id="course"
                        required>

                    <option value="">
                        Select Course
                    </option>

                    <option>
                        Full Stack Development
                    </option>

                    <option>
                        Java Full Stack
                    </option>

                    <option>
                        Python Full Stack
                    </option>

                    <option>
                        Artificial Intelligence & Machine Learning
                    </option>

                    <option>
                        Data Science
                    </option>

                    <option>
                        Data Analysis
                    </option>

                </select>

            </div>


            <div class="form-group">

                <label>Mode</label>

                <select id="mode" required>

                    <option value="">
                        Select Mode
                    </option>

                    <option>
                        Classroom
                    </option>

                    <option>
                        Online
                    </option>

                </select>

            </div>


            <button type="submit"
                    class="submit-btn">

                SUBMIT

                <i class="fa-solid fa-arrow-right"></i>

            </button>

        </form>

    </div>

</div>


