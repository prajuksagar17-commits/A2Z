<!-- ================= ABOUT PAGE ================= -->
<%-include('header.ejs');%>
<section class="about-page">

    <!-- PAGE TITLE -->
    <div class="about-banner">
        <h1>ABOUT US</h1>
    </div>


    <!-- ABOUT INTRO -->
    <div class="about-container">

        <div class="about-intro">

            <div class="about-text">

                <h2> <%= adata.title %></h2>

                <h3>About Us</h3>

                <p>
                   <%= adata.a_desc %>
                </p>

            </div>

            <div class="about-image">
                <img src="/img/<%= adata.a_img %>"height="100px" 
                     alt="Students Learning">
            </div>

        </div>


        <!-- ================= CEO DESK ================= -->

        <div class="section-heading">

            <span>LEADERSHIP</span>

            <h2>CEO Desk</h2>

            <p>
                A message from our leadership — guiding students to
                Learn, Build & Grow.
            </p>

        </div>


        <div class="ceo-card">

            <div class="ceo-image">

                <img src="/img/<%= adata.ceo_img %>"
                     alt="CEO">

                <h3> <%= adata.ceo_name %></h3>

                <p> <%= adata.c_position %></p>

            </div>


            <div class="ceo-content">

                <h2>CEO Desk</h2>

                <h3>
                    A Vision to Empower, A Mission to Transform
                </h3>

                <p>
                    At A2Z IT HUB, we believe that every student has
                    the potential to build a successful career when
                    given the right skills, guidance, and opportunities.
                </p>

              

                <strong>
                    Learn Today. Build Tomorrow. Grow Beyond.
                </strong>

                <p class="ceo-sign">
                    — Rahul Misal<br>
                    <i>CEO & Founder, A2Z IT HUB PVT. LTD.</i>
                </p>

            </div>

        </div>


        <!-- ================= MISSION VISION ================= -->

        <div class="section-heading">

            <span>OUR PURPOSE</span>

            <h2>   <%= adata.vision_title %></h2>

        </div>


        <!-- VISION -->

        <div class="about-row">

            <div class="row-content">

                <h3>OUR VISION</h3>

                <p>
   <%= adata.vision_desc %>

                </p>
            </div>

            <div class="row-image">

                <img src="/img/<%= adata.vision_img %>"
                     alt="Our Vision">

            </div>

        </div>


        <!-- MISSION -->

        <div class="about-row reverse">

            <div class="row-image">

                <img src="<%= adata.mission_img %>"
                     alt="Our Mission">

            </div>

            <div class="row-content">

                <h3> <%= adata.mission_title %></h3>

                <p>  
                           <%= adata.mission_desc %>

                </p>

            </div>

        </div>


